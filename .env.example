# ============================================
# TASTE HEAVEN & 99CHOPS - Environment Config
# ============================================

NODE_ENV=development
PORT=3000

# ─── MongoDB Atlas ────────────────────────────────────────────
# Use the +srv format (recommended). Get this from:
# Atlas Dashboard → Your Cluster → Connect → Drivers → copy string
# Replace <password> with your actual password
MONGO_URI=

# ─── Session & JWT ────────────────────────────────────────────
SESSION_SECRET=
JWT_SECRET=

# ─── Paystack ─────────────────────────────────────────────────
# Get your keys from: https://dashboard.paystack.com/#/settings/developers
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── WhatsApp ─────────────────────────────────────────────────
WHATSAPP_NUMBER=2349064345123

# ─── Restaurant Info ──────────────────────────────────────────
RESTAURANT_NAME=Taste Heaven & 99Chops
RESTAURANT_PHONE=08136974164
RESTAURANT_ADDRESS=Low-cost, behind youth center, Keffi, Nasarawa State, Nigeria

# ─── Email (optional) ─────────────────────────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password

# ─── Admin Credentials (change after first login!) ────────────
ADMIN_DEFAULT_EMAIL=
ADMIN_DEFAULT_PASSWORD=

# ─── Developer / Brand ────────────────────────────────────────
DEVELOPER_NAME=Amos Isaiah Tizhe
DEVELOPER_BRAND=OneXportal
DEVELOPER_URL=https://OneXportalhq.com

# ─── Rate Limiting ────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

<%- include('../partials/header') %>

<section class="page-hero page-hero-menu">
  <div class="container">
    <h1 class="page-hero-title"><i class="fas fa-utensils" aria-hidden="true"></i> Our Full Menu</h1>
    <p class="page-hero-sub">Fresh, hot, and made to order &mdash; every time</p>
  </div>
</section>

<section class="menu-page">
  <div class="container">

    <!-- Search + Filter Bar -->
    <div class="menu-filter-bar">
      <form method="GET" action="/menu" class="menu-search-form" role="search">
        <div class="menu-search-input">
          <i class="fas fa-search" aria-hidden="true"></i>
          <input type="search" name="search" placeholder="Search meals, drinks, snacks&hellip;" value="<%= search %>" aria-label="Search menu" />
          <% if (search) { %><a href="/menu" class="clear-search" aria-label="Clear search"><i class="fas fa-times" aria-hidden="true"></i></a><% } %>
        </div>
        <select name="available" aria-label="Filter by availability">
          <option value="">All Items</option>
          <option value="true"  <%= availableFilter === 'true'  ? 'selected' : '' %>>Available Only</option>
          <option value="false" <%= availableFilter === 'false' ? 'selected' : '' %>>Unavailable</option>
        </select>
        <button type="submit" class="btn btn-primary"><i class="fas fa-search" aria-hidden="true"></i> Search</button>
      </form>
    </div>

    <!-- Category Tabs -->
    <nav class="category-tabs" aria-label="Menu categories">
      <a href="/menu" class="cat-tab <%= activeCategory === 'all' ? 'active' : '' %>" aria-current="<%= activeCategory === 'all' ? 'page' : 'false' %>">
        <i class="fas fa-th-large" aria-hidden="true"></i> All
        <span class="cat-tab-count"><%= Object.values(countMap).reduce((s,c)=>s+c.total,0) %></span>
      </a>
      <% const catMeta2 = {
        'rice-meals':    { label:'Rice Meals',    icon:'fa-bowl-rice'    },
        'swallow-meals': { label:'Swallow Meals',  icon:'fa-circle-dot'   },
        'breakfast':     { label:'Breakfast',      icon:'fa-sun'          },
        'snacks':        { label:'Snacks',          icon:'fa-cookie-bite'  },
        'drinks':        { label:'Drinks',          icon:'fa-glass-water'  },
        'combo-offers':  { label:'Combo Offers',    icon:'fa-star'         },
      }; %>
      <% Object.entries(catMeta2).forEach(([key, meta]) => { %>
      <a href="/menu?category=<%= key %>"
         class="cat-tab <%= activeCategory === key ? 'active' : '' %>"
         aria-current="<%= activeCategory === key ? 'page' : 'false' %>">
        <i class="fas <%= meta.icon %>" aria-hidden="true"></i> <%= meta.label %>
        <% if (countMap[key]) { %>
        <span class="cat-tab-count"><%= countMap[key].available %>/<%= countMap[key].total %></span>
        <% } %>
      </a>
      <% }) %>
    </nav>

    <!-- Results info -->
    <div class="menu-results-info" role="status" aria-live="polite">
      <span><strong><%= items.length %></strong> item<%= items.length!==1?'s':'' %> found
        <% if (activeCategory !== 'all') { %> in <strong><%= categoryMeta[activeCategory]?.label %></strong><% } %>
        <% if (search) { %> for &ldquo;<strong><%= search %></strong>&rdquo;<% } %>
      </span>
      <% if (!user) { %>
      <span class="login-hint"><i class="fas fa-info-circle" aria-hidden="true"></i> <a href="/auth/login">Login</a> to place orders</span>
      <% } %>
    </div>

    <!-- Menu Items -->
    <% if (items.length === 0) { %>
    <div class="empty-state" role="alert">
      <i class="fas fa-search" aria-hidden="true"></i>
      <h3>No items found</h3>
      <p>Try a different search term or category.</p>
      <a href="/menu" class="btn btn-primary">Clear Filters</a>
    </div>
    <% } else { %>
    <%
      const grouped = {};
      items.forEach(item => {
        if (!grouped[item.category]) grouped[item.category] = [];
        grouped[item.category].push(item);
      });
      const iconMap = { 'rice-meals':'fa-bowl-rice','swallow-meals':'fa-circle-dot','breakfast':'fa-sun','snacks':'fa-cookie-bite','drinks':'fa-glass-water','combo-offers':'fa-star' };
    %>
    <% Object.entries(grouped).forEach(([cat, catItems]) => { %>
    <div class="menu-category-section">
      <div class="menu-category-header">
        <h2><i class="fas <%= iconMap[cat] || 'fa-utensils' %>" aria-hidden="true"></i> <%= categoryMeta[cat]?.label || cat %></h2>
        <span class="menu-cat-count"><i class="fas fa-check-circle" aria-hidden="true"></i> <%= catItems.filter(i=>i.isAvailable).length %> available</span>
      </div>
      <div class="menu-grid">
        <% catItems.forEach(item => { %>
        <article class="menu-card <%= !item.isAvailable ? 'menu-card-unavailable' : '' %>"
                 aria-label="<%= item.name %>"
                 data-item-id="<%= item._id %>">
          <div class="menu-card-image">
            <% if (item.image) { %>
              <img src="<%= item.image %>" alt="<%= item.name %>" loading="lazy" />
            <% } else { %>
              <div class="menu-card-placeholder" aria-hidden="true">
                <i class="fas <%= iconMap[item.category] || 'fa-utensils' %>"></i>
              </div>
            <% } %>
            <div class="menu-card-badges">
              <% if (item.isCombo)     { %><span class="badge-tag badge-combo"><i class="fas fa-star" aria-hidden="true"></i> Combo</span><% } %>
              <% if (item.isFeatured)  { %><span class="badge-tag badge-featured">Popular</span><% } %>
              <% if (!item.isAvailable){ %><span class="badge-tag badge-unavailable">Unavailable</span><% } %>
            </div>
          </div>
          <div class="menu-card-body">
            <div class="menu-card-category"><%= categoryMeta[item.category]?.label || cat %></div>
            <h3 class="menu-card-name"><%= item.name %></h3>
            <% if (item.description) { %>
            <%
  const descWords = (item.description || '').split(' ');
  const shortDesc = descWords.slice(0, 8).join(' ');
  const hasMore   = descWords.length > 8;
%>
<p class="menu-card-desc"><%= shortDesc %><% if(hasMore){ %>&hellip;<% } %></p>
            <% } %>
            <% if (item.prepTime) { %>
            <div class="menu-card-prep"><i class="fas fa-clock" aria-hidden="true"></i> ~<%= item.prepTime %> mins</div>
            <% } %>
            <% if (item.isCombo && item.comboItems?.length) { %>
            <div class="combo-includes"><i class="fas fa-layer-group" aria-hidden="true"></i> <%= item.comboItems.join(' + ') %></div>
            <% } %>
            <div class="menu-card-footer">
              <span class="menu-card-price">&#8358;<%= item.price.toLocaleString('en-NG') %></span>
              <div class="menu-card-actions">
                <a href="/menu/item/<%= item._id %>" class="btn-view-item" aria-label="View details for <%= item.name %>">
                  <i class="fas fa-eye" aria-hidden="true"></i>
                </a>
                <% if (item.isAvailable) { %>
                  <% if (user) { %>
                  <button class="btn-add-cart"
                    data-item-id="<%= item._id %>"
                    data-item-name="<%= item.name.replace(/"/g,'&quot;') %>"
                    data-item-price="<%= item.price %>"
                    data-has-options="<%= (item.customizationOptions?.length > 0).toString() %>"
                    data-spice-options="<%= (item.spiceOptions !== false).toString() %>"
                    data-options="<%= JSON.stringify(item.customizationOptions || []).replace(/"/g,'&quot;') %>"
                    aria-label="Add <%= item.name %> to cart">
                    <i class="fas fa-plus" aria-hidden="true"></i> Add
                  </button>
                  <% } else { %>
                  <a href="/auth/login?returnTo=/menu" class="btn-add-cart" aria-label="Login to add to cart">
                    <i class="fas fa-lock" aria-hidden="true"></i> Login
                  </a>
                  <% } %>
                <% } else { %>
                <span class="btn-unavailable" aria-label="Item unavailable">Unavailable</span>
                <% } %>
              </div>
            </div>
          </div>
        </article>
        <% }) %>
      </div>
    </div>
    <% }) %>
    <% } %>
  </div>
</section>

<%- include('../partials/footer') %>

<!-- Global Customize Modal — available on every page -->
<div class="modal-overlay" id="customizeOverlay" role="dialog" aria-modal="true" aria-labelledby="customizeItemName" style="display:none">
  <div class="modal customize-modal">
    <div class="modal-header">
      <h3 id="customizeItemName">Customize Your Order</h3>
      <button id="customizeCloseBtn" class="modal-close" aria-label="Close customize dialog">
        <i class="fas fa-times" aria-hidden="true"></i>
      </button>
    </div>
    <div class="modal-body">
      <div class="customize-price-row">
        <span>Price: <strong id="customizeItemPrice">&#8358;0</strong></span>
        <div class="customize-qty-control" role="group" aria-label="Quantity">
          <button id="customizeQtyDec" aria-label="Decrease quantity">
            <i class="fas fa-minus" aria-hidden="true"></i>
          </button>
          <span id="customizeQty" aria-live="polite">1</span>
          <button id="customizeQtyInc" aria-label="Increase quantity">
            <i class="fas fa-plus" aria-hidden="true"></i>
          </button>
        </div>
      </div>

      <fieldset id="customizeSpiceGroup" class="customize-group">
        <legend class="customize-label">
          <i class="fas fa-pepper-hot" aria-hidden="true"></i> Spice Level
        </legend>
        <div class="spice-options" role="radiogroup" aria-label="Spice level">
          <label class="spice-opt"><input type="radio" name="spiceLevel" value="no-spice" /> No Spice</label>
          <label class="spice-opt"><input type="radio" name="spiceLevel" value="mild" /> Mild</label>
          <label class="spice-opt"><input type="radio" name="spiceLevel" value="medium" checked /> Medium</label>
          <label class="spice-opt"><input type="radio" name="spiceLevel" value="spicy" /> Spicy</label>
          <label class="spice-opt"><input type="radio" name="spiceLevel" value="extra-spicy" /> Extra Spicy</label>
        </div>
      </fieldset>

      <div id="customizeOptions"></div>

      <div class="customize-group">
        <label class="customize-label" for="customizeInstructions">
          <i class="fas fa-comment" aria-hidden="true"></i> Special Instructions
        </label>
        <textarea id="customizeInstructions" rows="3"
          placeholder="Any special requests? e.g. no onions, extra sauce&hellip;"
          class="form-control"></textarea>
      </div>
    </div>
    <div class="modal-footer">
      <button id="customizeCancelBtn2" class="btn btn-outline">Cancel</button>
      <button id="customizeConfirmBtn" class="btn btn-primary">
        <i class="fas fa-cart-plus" aria-hidden="true"></i>
        Add to Cart &mdash; <span id="customizeTotalPrice">&#8358;0</span>
      </button>
    </div>
  </div>
</div>


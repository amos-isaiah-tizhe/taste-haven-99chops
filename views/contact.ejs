<%- include('partials/header') %>

  <section class="page-hero">
    <div class="container">
      <h1 class="page-hero-title"><i class="fas fa-phone"></i> Contact Us</h1>
      <p class="page-hero-sub">We'd love to hear from you. Reach us anytime!</p>
    </div>
  </section>

  <section style="padding:60px 0">
    <div class="container">
      <div style="display:grid;grid-template-columns:1fr 1.3fr;gap:48px;align-items:start">

        <!-- Contact Info -->
        <div>
          <h2 style="font-family:var(--font-display);font-size:1.8rem;font-weight:700;margin-bottom:24px">Get in Touch
          </h2>

          <div style="display:flex;flex-direction:column;gap:20px">
            <div style="display:flex;gap:14px;align-items:flex-start">
              <div
                style="width:44px;height:44px;border-radius:50%;background:var(--red-light);color:var(--red);display:flex;align-items:center;justify-content:center;font-size:1.2rem;flex-shrink:0">
                <i class="fas fa-map-marker-alt"></i>
              </div>
              <div>
                <strong>Our Location</strong>
                <p style="color:var(--gray);margin-top:4px;line-height:1.6">Low-cost, behind youth center,<br />Keffi,
                  Nasarawa State, Nigeria</p>
              </div>
            </div>
            <div style="display:flex;gap:14px;align-items:flex-start">
              <div
                style="width:44px;height:44px;border-radius:50%;background:var(--red-light);color:var(--red);display:flex;align-items:center;justify-content:center;font-size:1.2rem;flex-shrink:0">
                <i class="fas fa-phone"></i>
              </div>
              <div>
                <strong>Call Us</strong>
                <p style="margin-top:4px"><a href="tel:<%= restaurantPhone %>"
                    style="color:var(--red);font-size:1.1rem;font-weight:600">
                    <%= restaurantPhone %>
                  </a></p>
              </div>
            </div>
            <div style="display:flex;gap:14px;align-items:flex-start">
              <div
                style="width:44px;height:44px;border-radius:50%;background:#F0FFF4;color:#25D366;display:flex;align-items:center;justify-content:center;font-size:1.2rem;flex-shrink:0">
                <i class="fab fa-whatsapp"></i>
              </div>
              <div>
                <strong>WhatsApp</strong>
                <p style="margin-top:4px">
                  <a href="https://wa.me/<%= whatsappNumber %>" target="_blank" class="btn btn-whatsapp btn-sm"
                    style="margin-top:6px">
                    <i class="fab fa-whatsapp"></i> Chat on WhatsApp
                  </a>
                </p>
              </div>
            </div>
            <div style="display:flex;gap:14px;align-items:flex-start">
              <div
                style="width:44px;height:44px;border-radius:50%;background:var(--gold-light);color:var(--gold-dark);display:flex;align-items:center;justify-content:center;font-size:1.2rem;flex-shrink:0">
                <i class="fas fa-clock"></i>
              </div>
              <div>
                <strong>Opening Hours</strong>
                <p style="color:var(--gray);margin-top:4px;line-height:1.8">
                  Monday – Sunday<br />7:00 AM – 10:00 PM
                </p>
              </div>
            </div>
          </div>

          <div
            style="margin-top:32px;padding:20px;background:var(--bg);border-radius:var(--radius);border:1px solid var(--gray-light)">
            <p style="font-weight:600;margin-bottom:8px"><i class="fas fa-info-circle" style="color:var(--blue)"></i>
              Quick Tip</p>
            <p style="font-size:0.88rem;color:var(--gray)">For fastest response, use WhatsApp to contact us. We usually
              respond within minutes during operating hours!</p>
          </div>
        </div>

        <!-- Contact Form / CTA -->
        <div
          style="background:white;border-radius:var(--radius-lg);padding:40px;box-shadow:var(--shadow-lg);border:1px solid var(--gray-light)">
          <h3 style="font-weight:700;font-size:1.2rem;margin-bottom:6px">Ready to Order?</h3>
          <p style="color:var(--gray);margin-bottom:24px;font-size:0.9rem">The quickest way to reach us and place your
            order is via WhatsApp or by browsing our menu online.</p>

          <div style="display:flex;flex-direction:column;gap:12px">
            <a href="https://wa.me/<%= whatsappNumber %>?text=Hello%20Taste%20Heaven!%20I'd%20like%20to%20make%20an%20enquiry."
              target="_blank" class="btn btn-whatsapp btn-full btn-lg">
              <i class="fab fa-whatsapp"></i> Chat with Us on WhatsApp
            </a>
            <a href="/menu" class="btn btn-primary btn-full btn-lg">
              <i class="fas fa-utensils"></i> Browse & Order Online
            </a>
            <a href="tel:<%= restaurantPhone %>" class="btn btn-outline btn-full">
              <i class="fas fa-phone"></i> Call <%= restaurantPhone %>
            </a>
          </div>

          <div style="margin-top:28px;padding-top:20px;border-top:1px solid var(--gray-light);text-align:center">
            <p style="font-size:0.82rem;color:var(--gray-2)">
              Built by <a href="https://onexportalhq.com/about-founder/" target="_blank"
                style="color:var(--red);font-weight:600">Amos Isaiah Tizhe</a>
              · <a href="https://onexportalhq.com/about-onexportal/" target="_blank"
                style="color:var(--red);font-weight:600">OneXportal</a>
              · <a href="https://onexportalhq.com/about-onexportal/" target="_blank"
                style="color:var(--red);font-weight:600">OneXportalhq.com</a>
            </p>
          </div>
        </div>

      </div>
    </div>
  </section>

  <%- include('partials/footer') %>